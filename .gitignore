.DS_Store
*.env
!*.env.example
backup/
*.bak
*.tmp
state/
releases/
compose.override.yaml
deploy/private/
.freebuff/

# Python
__pycache__/
*.pyc

# Repo split (#952): `make assemble` writes release trees to out/. (apps/web/ is deliberately NOT
# ignored: the split repos' CI lays a workspace out there inside a noevia checkout and runs
# ripgrep, which would honour an ignore rule. CI refuses a committed apps/web instead.)
/out/

# Atomic fresh-install environment staging.
.env.fresh.*
qa-shots/
local-test/
.claude/*
!.claude/skills/
# The permission allowlist is shared on purpose: every session here runs the
# same test/typecheck/build commands, and prompting for them each time is noise.
!.claude/settings.json

# Framing eval reports (experiments/framing-eval)
/experiments/framing-eval/results/
