# Copy to .env. Never commit real credentials.
COWORK_PORT=8021
DIARY_PORT=8010
# Diary server fallback dates/times: use your IANA zone, never a fixed UTC offset.
# Shared by all users; browser-supplied entry stamps still take precedence.
# After changing TZ, recreate the diary container (a restart keeps the old env).
TZ=America/New_York
COWORK_STATE_DIR=./state

# Any OpenAI-compatible provider.
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=
DIARY_CHAT_MODEL=default
# Cheaper model for summarising and skip-classification. Leave unset to reuse
# DIARY_CHAT_MODEL; set it to a real model the endpoint serves to save time.
# It must be a name in GET /v1/models — "default" is a placeholder, not a model.
#DIARY_AUX_MODEL=
EMBEDDING_MODEL=default

# Fresh installs use a local corpus under state/diary/corpus.
CORPUS_BACKEND=local
CORPUS_ROOT=
# Only needed when CORPUS_BACKEND=s3: any S3-compatible endpoint (MinIO,
# Backblaze B2, AWS S3, Garage, ...). Path-style addressing; users can also
# connect their own S3-compatible storage per-account from the app's Settings.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_REGION=us-east-1
S3_PREFIX=
DIARY_MONTH_FILE_TEMPLATE={year}-{month02}.md
DIARY_ENTRY_LAYOUT=daily
DIARY_ENTRIES_PREFIX=Entries
DIARY_INDEX_ENABLED=false

# Optional: folders of pre-existing diary-like files (.txt/.md/.markdown)
# to surface in the diary's empty state. Comma-separated absolute paths;
# they must be mounted into the diary container to be visible. Files are
# only ever read; importing one file at a time copies its text into the
# corpus and leaves the original untouched.
DIARY_EXTERNAL_SOURCES=

# Set both before exposing the services outside a trusted machine.
UI_AUTH_TOKEN=
DIARY_AUTH_TOKEN=
LEGACY_AUTH_COMPAT=false
PUBLIC_ORIGIN=http://localhost:8021
WEBAUTHN_RP_ID=localhost
# Behind a reverse proxy, set TRUST_PROXY=true so per-IP rate limiting and
# audit logs see the real client IP (rightmost X-Forwarded-For entry) instead
# of the proxy IP. Leave false when exposing the app directly.
TRUST_PROXY=false
# Optional one-release direct Diary API mapping. Leave empty for internal-only Diary.
DIARY_LEGACY_USER_ID=

# Per-user requests-per-minute cap on model-backed routes (chat, diary
# Insights reflections). Everything shares one inference endpoint, so this
# stops one account from hogging it. Raise it for a beefier inference host.
LLM_RATE_LIMIT=60

# Optional provider-specific model management.
MODEL_MANAGER_KIND=none
MODEL_MANAGER_BASE_URL=
MODEL_MANAGER_API_KEY=

# Members may connect only to these operator-approved origins (comma-separated).
# Leave empty to reserve custom providers/storage for administrators.
MEMBER_OUTBOUND_ORIGINS=
# Optional auxiliary endpoint and key. If unset, reuse the main inference values.
# AUX_INFERENCE_BASE_URL=https://inference.example.com/v1
# AUX_INFERENCE_API_KEY=

# Optional MCP server, exposing curated Nextcloud toolboxes to the model.
# Streamable-http endpoint, usually .../mcp. Leave empty to disable MCP
# entirely; only the built-in `core` toolbox is then offered.
# The server must run in multi-user mode: noevia passes each user's own
# Nextcloud app password per request and stores nothing extra.
# MCP_SERVER_URL=http://nextcloud-mcp:8000/mcp
#
# Comma-separated origins that are the same Nextcloud the MCP server is
# configured against. noevia forwards a user's stored app password to the MCP
# server ONLY when their storage connection points at one of these, so a
# credential for some other server is never handed over. One Nextcloud often
# has several origins (a LAN address and a public hostname) — list them all.
# MCP_NEXTCLOUD_ORIGINS=https://drive.example.com,http://10.0.0.5:11000
