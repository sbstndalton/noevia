# Copy to .env. Never commit real credentials.
COWORK_PORT=8021
DIARY_PORT=8010
# Diary server fallback dates/times: use your IANA zone, never a fixed UTC offset.
# Shared by all users; browser-supplied entry stamps still take precedence.
# After changing TZ, recreate the diary container (a restart keeps the old env).
TZ=America/New_York
# Existing installations retain this bind path when storage overrides are empty.
COWORK_STATE_DIR=./state
# Fresh-install init-managed.sh selects web-data / diary-data (Docker volumes).
# Explicit overrides take precedence over COWORK_STATE_DIR. Never switch existing
# state to empty volumes; migrate/restore separately if changing storage later.
COWORK_WEB_STORAGE=
COWORK_DIARY_STORAGE=

# Any OpenAI-compatible provider.
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=
DIARY_CHAT_MODEL=default
# Cheaper model for summarising and skip-classification. Leave unset to reuse
# DIARY_CHAT_MODEL; set it to a real model the endpoint serves to save time.
# It must be a name in GET /v1/models — "default" is a placeholder, not a model.
#DIARY_AUX_MODEL=
EMBEDDING_MODEL=default
# Optional separate embeddings endpoint (for example a CPU-only llama-server), so
# retrieval does not evict the chat model on a single-slot engine. No inference key is sent.
#EMBEDDING_BASE_URL=

# Fresh installs use a local corpus under state/diary/corpus.
CORPUS_BACKEND=local
CORPUS_ROOT=
# Only needed when CORPUS_BACKEND=s3: any S3-compatible endpoint (MinIO,
# Backblaze B2, AWS S3, Garage, ...). Path-style addressing; users can also
# connect their own S3-compatible storage per-account from the app's Settings.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_REGION=us-east-1
S3_PREFIX=
DIARY_MONTH_FILE_TEMPLATE={year}-{month02}.md
DIARY_ENTRY_LAYOUT=daily
DIARY_ENTRIES_PREFIX=Entries
DIARY_INDEX_ENABLED=false

# Optional: folders of pre-existing diary-like files (.txt/.md/.markdown)
# to surface in the diary's empty state. Comma-separated absolute paths;
# they must be mounted into the diary container to be visible. Files are
# only ever read; importing one file at a time copies its text into the
# corpus and leaves the original untouched.
DIARY_EXTERNAL_SOURCES=

# Set both before exposing the services outside a trusted machine.
UI_AUTH_TOKEN=
DIARY_AUTH_TOKEN=
LEGACY_AUTH_COMPAT=false
PUBLIC_ORIGIN=http://localhost:8021
WEBAUTHN_RP_ID=localhost
# Behind a reverse proxy, set TRUST_PROXY=true so per-IP rate limiting and
# audit logs see the real client IP (rightmost X-Forwarded-For entry) instead
# of the proxy IP. Leave false when exposing the app directly.
TRUST_PROXY=false
# Optional one-release direct Diary API mapping. Leave empty for internal-only Diary.
DIARY_LEGACY_USER_ID=

# Per-user requests-per-minute cap on model-backed routes (chat, diary
# Insights reflections). Everything shares one inference endpoint, so this
# stops one account from hogging it. Raise it for a beefier inference host.
LLM_RATE_LIMIT=60

# Optional provider-specific model management.
MODEL_MANAGER_KIND=none
MODEL_MANAGER_BASE_URL=
MODEL_MANAGER_API_KEY=

# Members may connect only to these operator-approved origins (comma-separated).
# Leave empty to reserve custom providers/storage for administrators.
MEMBER_OUTBOUND_ORIGINS=
# Optional auxiliary endpoint and key. If unset, reuse the main inference values.
# AUX_INFERENCE_BASE_URL=https://inference.example.com/v1
# AUX_INFERENCE_API_KEY=

# Optional MCP server, exposing curated Nextcloud toolboxes to the model.
# Streamable-http endpoint, usually .../mcp. Leave empty to disable MCP
# entirely; only the built-in `core` toolbox is then offered.
# The server must run in multi-user mode: noevia passes each user's own
# Nextcloud app password per request and stores nothing extra.
# MCP_SERVER_URL=http://nextcloud-mcp:8000/mcp
#
# Comma-separated origins that are the same Nextcloud the MCP server is
# configured against. noevia forwards a user's stored app password to the MCP
# server ONLY when their storage connection points at one of these, so a
# credential for some other server is never handed over. One Nextcloud often
# has several origins (a LAN address and a public hostname) — list them all.
# MCP_NEXTCLOUD_ORIGINS=https://drive.example.com,http://10.0.0.5:11000
#
# Several MCP servers at once: comma-separated `id|url|auth` entries. `auth` is
# `nextcloud` (forward the user's own Nextcloud app password, subject to
# MCP_NEXTCLOUD_ORIGINS above), `bearer:ENV_NAME` (a static service token read
# from that environment variable) or `none`. Omitting it means `none` — a server
# never inherits a credential by accident. Set, this takes precedence over
# MCP_SERVER_URL. The URLs are logged verbatim at startup, so a token goes in its
# own variable via `bearer:NAME` and never in the URL.
# MCP_SERVERS=nextcloud|http://nextcloud-mcp:8000/mcp|nextcloud,tavily|https://mcp.tavily.com/mcp|bearer:TAVILY_API_KEY
#
# Values for the `bearer:NAME` references above. One variable per token.
# TAVILY_API_KEY=
#
# Which curated toolboxes the picker offers. Unset offers all of them; `core` is
# always offered. This is about what anyone wants to see, not about what a box
# contains — turning one back on is a variable, not a commit.
# ENABLED_TOOLBOXES=core,web-search,nextcloud-files
#
# noevia's own capabilities offered over MCP — the Diary (read-only) and this
# project's documents. It runs IN PROCESS on a second listener bound to
# 127.0.0.1, so it is not a container and must never appear in `ports:`: it
# answers to a short-lived capability token rather than to a session cookie.
# 0 (the default) starts nothing and both toolboxes disappear. To enable it,
# set a free port AND name it in MCP_SERVERS with auth `internal`, which is
# accepted only for a loopback IP literal.
# MCP_INTERNAL_PORT=8022
# MCP_SERVERS=noevia|http://127.0.0.1:8022/mcp|internal

# Optional limited Markdown sharing endpoint. Disabled by default; see docs/dav.md.
# Publishing a separate port requires an explicit Compose override.
COWORK_DAV_PORT=0
COWORK_DAV_SCOPE=
COWORK_DAV_ORIGIN=
COWORK_DAV_PROXY_TOKEN=

# Direct native llama.cpp (optional; see docs/spec-direct-llamacpp.md).
# MODEL_MANAGER_KIND=llamacpp
# MODEL_MANAGER_BASE_URL=http://llama:8080
# INFERENCE_BASE_URL=http://llama:8080/v1
# LLAMACPP_PRESET_PATH=/llamacpp-config/models.ini
# compose.llamacpp.yaml requires qualified host paths/devices and explicit model IDs.
# LLAMACPP_CONFIG_DIR=/path/to/qualified/config
# LLAMACPP_MODELS_DIR=/path/to/existing/public/models
# LLAMACPP_CACHE_DIR=/path/to/dedicated/native/cache
# LLAMACPP_RENDER_DEVICE=/dev/dri/renderD129
# LLAMACPP_CARD_DEVICE=/dev/dri/card1
# LLAMACPP_CHAT_MODEL=your-native-chat-preset
# LLAMACPP_AUX_MODEL=your-native-aux-preset
# LLAMACPP_EMBED_MODEL=your-native-embedding-preset
# Model Loader, served to noevia administrators at /model-loader (compose.llamacpp.yaml).
# MODEL_LOADER_DATA_DIR=/path/to/model-loader/data
# MODEL_LOADER_LLAMA_CONTAINERS=cowork-llama-1   # blank discovers llama.cpp containers
# MODEL_LOADER_GPU_VRAM=cowork-llama-1:16          # needed for Vulkan images (GiB)
# MODEL_LOADER_HOST_RAM_RESERVE_GB=8

# Optional private Laya typed-decision service (compose profile: laya).
# Answering models still use their independently selected OpenAI-compatible provider.
COWORK_DECISION_URL=
COWORK_LAYA_MODEL_DIR=
# Empty permits the admin Experimental switch; false locks it off.
NOEVIA_FEATURE_STEP_SUPERVISION=

# Image tags. Each image is tagged by what it contains, so a web-only release bumps
# COWORK_VERSION alone and never leaves sidecar tags that were never built.
# See docs/deployment.md "Per-service image tags".
COWORK_VERSION=dev
DIARY_VERSION=dev
OCR_VERSION=dev
# Only used with compose.llamacpp.yaml / the model-loader override.
MODEL_MANAGER_VERSION=dev
