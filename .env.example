# Copy to .env. Never commit real credentials.
# Host bind for the web UI. Default is loopback-only (tunnel origin http://127.0.0.1:8021).
# For direct LAN access set COWORK_PORT=8021 and keep TRUST_PROXY=false.
COWORK_PORT=127.0.0.1:8021
DIARY_PORT=8010
# Diary server fallback dates/times: use your IANA zone, never a fixed UTC offset.
# Shared by all users; browser-supplied entry stamps still take precedence.
# After changing TZ, recreate the diary container (a restart keeps the old env).
TZ=America/New_York
# Existing installations retain this bind path when storage overrides are empty.
COWORK_STATE_DIR=./state
# The assembled release tree every image builds from (repo split, #952): `make assemble` writes
# one to out/tree. Use an absolute path. Unset, Compose looks in `..` (the tree's own noevia/).
# COWORK_SOURCE_DIR=/absolute/path/to/noevia/out/tree
# Fresh-install init-managed.sh selects web-data / diary-data (Docker volumes).
# Explicit overrides take precedence over COWORK_STATE_DIR. Never switch existing
# state to empty volumes; migrate/restore separately if changing storage later.
COWORK_WEB_STORAGE=
COWORK_DIARY_STORAGE=

# Any OpenAI-compatible provider.
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=
DIARY_CHAT_MODEL=default
# Cheaper model for summarising and skip-classification. Leave unset to reuse
# DIARY_CHAT_MODEL; set it to a real model the endpoint serves to save time.
# It must be a name in GET /v1/models — "default" is a placeholder, not a model.
#DIARY_AUX_MODEL=
# Optional explicit substitutes when the id above is not served by the router. Without them an unserved id
# makes the diary refuse to answer; the release preflight (deploy/preflight/diary-models-check.sh) refuses a
# cutover in that state. They count only if your Compose files pass them into the diary service (the shipped
# ones do). Leave unset to require the ids above to be served.
#LLM_CHAT_FALLBACK_MODEL=
#LLM_AUX_FALLBACK_MODEL=
EMBEDDING_MODEL=default
# Optional separate embeddings endpoint (for example a CPU-only llama-server), so
# retrieval does not evict the chat model on a single-slot engine. No inference key is sent.
#EMBEDDING_BASE_URL=
# How text is framed for the embedding model (#1636): nomic-v1 (default; text sent unchanged, as
# always) or embeddinggemma-2 (the model card's prompts). Stored vectors belong to one (profile, model)
# pair, so change the model or profile only through a re-index: set the target below (or use
# Settings / POST /api/embedding), let both indexes fill, then switch. Rollback keeps the old vectors.
#EMBEDDING_PROFILE=nomic-v1
#EMBEDDING_NEXT_MODEL=embeddinggemma-2
#EMBEDDING_NEXT_BASE_URL=http://embed-next:8080/v1
#EMBEDDING_NEXT_PROFILE=embeddinggemma-2
# Share of the time the background re-index may keep the embeddings server busy (0.05 to 1).
#EMBEDDING_REINDEX_DUTY=0.5
# compose.embed.yaml's optional `embed-next` service (profile embed-next): EmbeddingGemma 2 beside
# nomic during a re-index. Image must include llama.cpp #30054 (gemma-embedding2); see that file.
#EMBED_NEXT_IMAGE=
#EMBED_NEXT_MODEL_FILE=embeddinggemma-2/embeddinggemma-2-Q8_0.gguf
#EMBED_NEXT_ALIAS=embeddinggemma-2
#EMBED_NEXT_MEMORY_LIMIT=3g
#EMBED_NEXT_CPUS=4

# Fresh installs use a local corpus under state/diary/corpus.
CORPUS_BACKEND=local
CORPUS_ROOT=
# Only needed when CORPUS_BACKEND=s3: any S3-compatible endpoint (MinIO,
# Backblaze B2, AWS S3, Garage, ...). Path-style addressing; users can also
# connect their own S3-compatible storage per-account from the app's Settings.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_REGION=us-east-1
S3_PREFIX=
DIARY_MONTH_FILE_TEMPLATE={year}-{month02}.md
DIARY_ENTRY_LAYOUT=daily
DIARY_ENTRIES_PREFIX=Entries
DIARY_INDEX_ENABLED=false

# Optional: folders of pre-existing diary-like files (.txt/.md/.markdown)
# to surface in the diary's empty state. Comma-separated absolute paths;
# they must be mounted into the diary container to be visible. Files are
# only ever read; importing one file at a time copies its text into the
# corpus and leaves the original untouched.
DIARY_EXTERNAL_SOURCES=

# Set both before exposing the services outside a trusted machine.
UI_AUTH_TOKEN=
DIARY_AUTH_TOKEN=
# Per-request Diary tenant assertion (M2). Shared by web and diary only; generate with
# openssl rand -hex 32. Deploy the diary sidecar before web when first setting it.
DIARY_TENANT_KEY=
# With DIARY_AUTH_TOKEN and DIARY_TENANT_KEY both empty the diary refuses to start
# unless this is 1 (explicit LAN-only open mode).
DIARY_ALLOW_OPEN=
LEGACY_AUTH_COMPAT=false
PUBLIC_ORIGIN=http://localhost:8021
WEBAUTHN_RP_ID=localhost
# Behind a reverse proxy, set TRUST_PROXY=true so per-IP rate limiting and
# audit logs see the real client IP (rightmost X-Forwarded-For entry) instead
# of the proxy IP. Leave false when exposing the app directly.
TRUST_PROXY=false
# Full-Rust migration M1: who faces the network on the web port. Only rust is accepted: the Rust front
# (noevia-server) on 8021 with Node behind it on loopback 9021. node is refused (sbstndalton/noevia#1071).
# TRUST_PROXY applies to both.
NOEVIA_FRONT=rust
# Optional one-release direct Diary API mapping. Leave empty for internal-only Diary.
DIARY_LEGACY_USER_ID=

# Per-user requests-per-minute cap on model-backed routes (chat, diary
# Insights reflections). Everything shares one inference endpoint, so this
# stops one account from hogging it. Raise it for a beefier inference host.
LLM_RATE_LIMIT=60

# Optional provider-specific model management.
MODEL_MANAGER_KIND=none
MODEL_MANAGER_BASE_URL=
MODEL_MANAGER_API_KEY=

# Members may connect only to these operator-approved origins (comma-separated).
# Leave empty to reserve custom providers/storage for administrators.
MEMBER_OUTBOUND_ORIGINS=
# Optional auxiliary endpoint and key. If unset, reuse the main inference values.
# AUX_INFERENCE_BASE_URL=https://inference.example.com/v1
# AUX_INFERENCE_API_KEY=

# Optional MCP server, exposing curated Nextcloud toolboxes to the model.
# Streamable-http endpoint, usually .../mcp. Leave empty to disable MCP
# entirely; only the built-in `core` toolbox is then offered.
# The server must run in multi-user mode: noevia passes each user's own
# Nextcloud app password per request and stores nothing extra.
# MCP_SERVER_URL=http://nextcloud-mcp:8000/mcp
#
# Comma-separated origins that are the same Nextcloud the MCP server is
# configured against. noevia forwards a user's stored app password to the MCP
# server ONLY when their storage connection points at one of these, so a
# credential for some other server is never handed over. One Nextcloud often
# has several origins (a LAN address and a public hostname) — list them all.
# MCP_NEXTCLOUD_ORIGINS=https://drive.example.com,http://10.0.0.5:11000
#
# Several MCP servers at once: comma-separated `id|url|auth` entries. `auth` is
# `nextcloud` (forward the user's own Nextcloud app password, subject to
# MCP_NEXTCLOUD_ORIGINS above), `bearer:ENV_NAME` (a static service token read
# from that environment variable) or `none`. Omitting it means `none` — a server
# never inherits a credential by accident. Set, this takes precedence over
# MCP_SERVER_URL. The URLs are logged verbatim at startup, so a token goes in its
# own variable via `bearer:NAME` and never in the URL.
# MCP_SERVERS=nextcloud|http://nextcloud-mcp:8000/mcp|nextcloud,tavily|https://mcp.tavily.com/mcp|bearer:TAVILY_API_KEY
#
# Values for the `bearer:NAME` references above. One variable per token.
# TAVILY_API_KEY=
#
# Which curated toolboxes the picker offers. Unset offers all of them; `core` is
# always offered. This is about what anyone wants to see, not about what a box
# contains — turning one back on is a variable, not a commit.
# ENABLED_TOOLBOXES=core,web-search,nextcloud-files
#
# noevia's own capabilities offered over MCP — the Diary (read-only) and this
# project's documents. It runs IN PROCESS on a second listener bound to
# 127.0.0.1, so it is not a container and must never appear in `ports:`: it
# answers to a short-lived capability token rather than to a session cookie.
# 0 (the default) starts nothing and both toolboxes disappear. To enable it,
# set a free port AND name it in MCP_SERVERS with auth `internal`, which is
# accepted only for a loopback IP literal.
# MCP_INTERNAL_PORT=8022
# MCP_SERVERS=noevia|http://127.0.0.1:8022/mcp|internal

# Optional limited Markdown sharing endpoint. Disabled by default; see docs/dav.md.
# Publishing a separate port requires an explicit Compose override.
COWORK_DAV_PORT=0
COWORK_DAV_SCOPE=
COWORK_DAV_ORIGIN=
COWORK_DAV_PROXY_TOKEN=

# Direct native inference engine (optional; see docs/spec-direct-llamacpp.md). Web and Diary reach the
# router through the inference gate (noevia#2115), never directly.
# MODEL_MANAGER_KIND=llamacpp
# MODEL_MANAGER_BASE_URL=http://inference-gate:8080
# INFERENCE_BASE_URL=http://inference-gate:8080/v1
# LLAMACPP_PRESET_PATH=/llamacpp-config/models.ini
# models.ini writer: model-loader (default in compose.llamacpp.yaml; web mounts the dir :ro).
# Rollback only: MODELS_INI_WRITER=web together with removing :ro from web's /llamacpp-config.
# MODELS_INI_WRITER=model-loader
# compose.llamacpp.yaml requires qualified host paths/devices and explicit model IDs.
# LLAMACPP_CONFIG_DIR=/path/to/qualified/config
# LLAMACPP_MODELS_DIR=/path/to/existing/public/models
# LLAMACPP_CACHE_DIR=/path/to/dedicated/native/cache
# LLAMACPP_RENDER_DEVICE=/dev/dri/renderD129
# LLAMACPP_CARD_DEVICE=/dev/dri/card1
# LLAMACPP_CHAT_MODEL=your-native-chat-preset
# LLAMACPP_AUX_MODEL=your-native-aux-preset
# LLAMACPP_EMBED_MODEL=your-native-embedding-preset
# Model Loader, served to noevia administrators at /model-loader (compose.llamacpp.yaml).
# MODEL_LOADER_DATA_DIR=/path/to/model-loader/data
# MODEL_LOADER_LLAMA_CONTAINERS=cowork-llama-1   # blank discovers llama.cpp containers
# MODEL_LOADER_GPU_VRAM=cowork-llama-1:16          # needed for Vulkan images (GiB)
# MODEL_LOADER_HOST_RAM_RESERVE_GB=8
# Unload an idle chat model after this many seconds without a request (#1747). Blank = 900
# (15 min); 0 keeps it loaded. A busy model is never unloaded; the next request reloads it.
# Embedding models (embedding.ini) and Laya are not affected.
# CHAT_MODEL_IDLE_UNLOAD_SECONDS=
# Inference gate (noevia#2115; docs/deployment.md "Inference gate"). One secret, read by the gate
# (as GATE_ADMIN_TOKEN) and by web: 16 to 256 printable characters, e.g. openssl rand -hex 32.
# Blank: nobody can unload a model that is answering. Every GATE_* below is optional; blank takes
# the gate's default, and an invalid value stops the gate before it listens.
# INFERENCE_GATE_ADMIN_TOKEN=
# GATE_CHAT_SLOTS=                       # only 1 is supported
# GATE_EXEMPT_MODELS=                    # comma-separated ids the gate never schedules
# GATE_MAX_WAIT_SECONDS=                 # 600: longest wait in the queue
# GATE_FAIR_HOLD_SECONDS=                # 60: how long a waiting model may be passed over
# GATE_RESIDENCY_GRACE_SECONDS=          # 20: keep a just-used model for its next call (0 to 3600)
# GATE_LEASE_IDLE_SECONDS=               # 30: a lease with no request for this long ends
# GATE_LEASE_HARD_SECONDS=               # 1800: no lease lasts longer
# GATE_UNLOAD_TIMEOUT_SECONDS=           # 45: then the switch is reported stuck
# GATE_ROUTER_DOWN_GRACE_SECONDS=        # 30
# GATE_SESSION_HOLD_SECONDS=             # 120
# GATE_MAX_WAITERS=                      # 64
# GATE_MAX_LEASES=                       # 64
# GATE_MAX_BODY_BYTES=                   # 64 MiB per request body
# GATE_MAX_BUFFERED_BYTES=               # 256 MiB of bodies in total
# GATE_BODY_TIMEOUT_SECONDS=             # 60
# GATE_UPSTREAM_HEADER_TIMEOUT_SECONDS=  # 900
# GATE_HEADER_READ_TIMEOUT_SECONDS=      # 30
# GATE_MAX_CONNECTIONS=                  # 512
# On a separate inference machine (deploy/examples/inference-gate.override.yml), the address and
# port web and Diary used for the router, which the gate now takes over:
# INFERENCE_GATE_PUBLISH=
# One model at a time within an inference memory budget (#697). The engine runs --models-max 1
# (compose.llamacpp.yaml). INFERENCE_MEMORY_BUDGET_GIB is only the initial budget; administrators
# change it in Settings → Models & routing (2 GiB to host RAM less 4 GiB). Loads whose estimate
# (weights + KV at the preset context + projector + runtime, x1.05, + prompt cache) exceed it
# are refused, and autoconfig never suggests past it.
# INFERENCE_MEMORY_BUDGET_GIB=16
# Prompt cache (--cache-ram, MiB): the value autoconfig and new presets write, and the hard
# maximum any saved value is clamped to (web and the model loader both apply these).
# LLAMACPP_AUTOCONFIG_CACHE_RAM_MAX_MIB=1024
# LLAMACPP_CACHE_RAM_HARD_MAX_MIB=2048
# Runtime safety net: unload the engine's model when GPU memory in use (sysfs GTT + VRAM) plus
# the engine container's memory stays above the budget by more than the overshoot.
# INFERENCE_BUDGET_WATCH=on
# INFERENCE_BUDGET_WATCH_INTERVAL_MS=15000
# INFERENCE_BUDGET_OVERSHOOT_PCT=10
# Comma-separated GTT counters of the engine's GPU; blank reads every /sys/class/drm/card*.
# INFERENCE_GTT_USED_PATH=/sys/class/drm/card1/device/mem_info_gtt_used
# The engine container whose anonymous memory counts (embed/rerank share its image but are
# outside the budget). Blank: the compose `llama` service's container.
# INFERENCE_ENGINE_CONTAINER=cowork-llama-1
# Services assigned to another Inference machine (#1843) are outside this budget and are checked by
# preflight and the restart alert from this optional list (docs/deployment.md, "Services on other
# Inference machines"). Unset: nothing changes.
# Roles: decision, sensitivity, embedding, reranker. A service that needs a key gets
# NOEVIA_REMOTE_<ROLE>_AUTH_FILE: a mode-0600 file holding one header line (never the key itself here).
# NOEVIA_REMOTE_SERVICES=embedding,reranker
# NOEVIA_REMOTE_EMBEDDING_HEALTH_URL=http://pi5.lan:8080/health
# Model loader: write an explicit bounded cache-ram into chat sections at start (default true).
# MIGRATE_CACHE_RAM_ON_START=true
# Optional RAG reranker (#1665). It never runs on the shared engine (that would evict the chat model).
# The supported sidecar is compose.rerank.yaml: gte-multilingual-reranker-base int8 on TEI (CPU,
# 2 CPUs, 2 GiB). Off until NOEVIA_FEATURE_RAG_RERANK=true; runbook: docs/deployment.md,
# "Enable the gte reranker". A slow or failed rerank falls back to embedding order.
NOEVIA_FEATURE_RAG_RERANK=
# tei (TEI POST /rerank, the gte sidecar) or llamacpp (llama.cpp --reranking, POST /v1/rerank).
# Blank: llamacpp in the base stack; compose.rerank.yaml defaults it to tei.
RERANK_BACKEND=
# Blank with tei: http://rerank:8080 (the sidecar). Another machine on this network works too
# (#1755); a public address is refused (#1760).
RERANK_BASE_URL=
# Display name on the Models page (TEI serves one model; llama.cpp also sends it as `model`).
RERANK_MODEL=
# The reranker gets its own key only (never INFERENCE_API_KEY); blank on the internal network.
RERANK_API_KEY=
# #1665 optional per-backend overrides for the Models page reranker choice. Blank: derived from
# RERANK_BACKEND/RERANK_BASE_URL/RERANK_MODEL (the live TEI sidecar needs none of these).
RERANK_TEI_BASE_URL=
RERANK_TEI_MODEL=
RERANK_LLAMACPP_BASE_URL=
# Pool reranked (6-24, default 12), chunks kept (default 6), deadline in ms (default 3000).
RAG_RERANK_POOL=
RAG_RERANK_KEEP=
RAG_RERANK_DEADLINE_MS=
# compose.rerank.yaml only: the gte ONNX snapshot folder (holds onnx/model_int8.onnx), mounted read-only.
# RERANK_MODEL_DIR=/mnt/user/ai-models/rerank-eval/onnx-community_gte-multilingual-reranker-base/ee64367e35a2db0da46bb6497e13a18f8bd585cb
# CPU quota (default 2) and memory cap (default 2g) of the rerank sidecar.
# RERANK_CPUS=2
# RERANK_MEMORY_LIMIT=2g
# RERANK_SHARED_ENGINE=

# Optional private Laya typed-decision service (compose profile: laya).
# Answering models still use their independently selected OpenAI-compatible provider.
COWORK_DECISION_URL=
# #1639: the decision model behind COWORK_DECISION_URL, by id (not a file name). Empty or unknown: Laya's
# contract and wording, as before. kev-0.8b: Kev-0.8B on Ollaya (TypeSafe, calibration T 0.45); see
# docs/kev-cutover.md. The key is the Ollaya bearer key (OLLAYA_API_KEY of that container), sent only
# to a TypeSafe service.
COWORK_DECISION_MODEL=
COWORK_DECISION_API_KEY=
# Optional: the sensitivity check alone on its own service (e.g. http://laya:8040 while
# COWORK_DECISION_URL is Kev). Empty: the shared service, as before. Set but not a private
# decision-service URL: the check is off and turns stay local. Its model defaults to Laya.
COWORK_SENSITIVITY_DECISION_URL=
COWORK_SENSITIVITY_DECISION_MODEL=
# #1745: the bearer key for the sensitivity service. Empty: COWORK_DECISION_API_KEY is sent there only
# when it is on the same host as COWORK_DECISION_URL; a service on another host gets no key.
COWORK_SENSITIVITY_DECISION_API_KEY=
COWORK_LAYA_MODEL_DIR=
# Laya worker request deadline in seconds (0.5 to 2.0, default 1.3). Out-of-range or garbage values
# are logged and ignored. Keep the web decision deadline (Settings, max 2000 ms) at or above it;
# recommended pair: LAYA_DECISION_TIMEOUT_S=1.8 with a 2000 ms web deadline. Needs a Laya image rebuild.
# LAYA_DECISION_TIMEOUT_S=1.3
# Tag of the cowork-laya image that the laya profile runs (built from services/laya). Commented out:
# compose falls back to 0.3.5-noevia1. Set it when a rebuilt Laya image (native launcher) is on the host.
# LAYA_VERSION=0.3.5-noevia1
# Empty permits the admin Experimental switch; false locks it off.
NOEVIA_FEATURE_STEP_SUPERVISION=

# Image tags. Each image is tagged by what it contains, so a web-only release bumps
# COWORK_VERSION alone and never leaves sidecar tags that were never built.
# See docs/deployment.md "Per-service image tags".
COWORK_VERSION=dev
DIARY_VERSION=dev
OCR_VERSION=dev
# Only used with compose.llamacpp.yaml / the model-loader override.
MODEL_MANAGER_VERSION=dev
# Only used with compose.docling.yaml (the compose default is also dev).
DOCLING_VERSION=dev
# Only used with deploy/examples/code-sandbox.override.yml; its compose default is `local`, and a
# commented line is not touched by the `sed -i s/^CODE_SANDBOX_VERSION=.../` bump in deployment.md,
# so uncomment it when you build that image.
# CODE_SANDBOX_VERSION=local

# Code-task verification (#703), with deploy/examples/code-sandbox.override.yml. Runs in the
# separate, one-shot code-verify container (git as 1002, tests as 1003, no network, workspaces read-only). CODE_VERIFY is the
# operator's command per repository, `name|command` (names as in CODE_REPOS); unset = off.
# CODE_VERIFY_ENDPOINT tells web where the verifier listens.
# CODE_VERIFY=scratch|node --test
# CODE_VERIFY_WALL_MS=600000
# CODE_VERIFY_ENDPOINT=unix:/run/noevia-verify/verify.sock
# The group the source repositories are shared with the verifier's git uid through (chgrp -R, g+rX).
# CODE_REPOS_GID=1005
