# AnythingLLM env — copy to anythingllm.env and fill in. Do not commit the filled copy.
# chmod 600 anythingllm.env on the server.

# Required — AnythingLLM refuses to boot without it. Generate: openssl rand -hex 32
JWT_SECRET=

# Single-user mode is the default (MULTI_USER_MODE unset/false).
# Auth for you = the password you set on first open (stored locally, JWT-guarded).

# Telemetry off (privacy + local-first).
DISABLE_TELEMETRY=true

# NOTE: STORAGE_DIR is set in docker-compose.yml (environment:) — the official image
# requires it or the collector crash-loops on boot.

# Preseed the system-wide LLM provider so first-run setup is already pointed at the
# gateway (can also be set/changed in the UI: Settings → AI Providers → LLM →
# Generic OpenAI). Base URL resolves inside the compose network.
GENERIC_OPENAI_BASE_URL=http://litellm:4000/v1
GENERIC_OPENAI_API_KEY=<paste LITELLM_MASTER_KEY here>
GENERIC_OPENAI_MODEL_PREF=e4b

# Embedder / vector DB: leave defaults (built-in local embedder + LanceDB).
# Deliberately separate from diary-companion's nomic-embed/sqlite-vec index.
