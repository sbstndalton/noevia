# LiteLLM gateway env — copy to litellm/.env and fill in. Do not commit the filled copy.
# chmod 600 litellm/.env on the server.

# The API key AnythingLLM will use against the gateway (Settings → AI Providers → LLM → Generic OpenAI).
# Generate: openssl rand -hex 24
LITELLM_MASTER_KEY=

# Must match DIARY_AUTH_TOKEN from the standalone diary-companion .env —
# COPIED during migration (MIGRATION.md step), never regenerated.
DIARY_AUTH_TOKEN=

# Optional but recommended: encrypts/keys LiteLLM cached params.
# Generate: openssl rand -hex 32
LITELLM_SALT_KEY=

# Phase 2 (cloud escape hatch) — leave unset until adopted:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
