# diary-companion sidecar env — cowork stack.
#
# On DaServer this file is COPIED from the standalone container's .env
# (/mnt/docker/appdata/diary-companion/.env) — credentials migrate, they are never
# regenerated (build-spec §9). The reference template below matches the repo's
# .env.example; the real server values already exist and are correct.

WEBDAV_BASE_URL=http://10.69.0.130:11000/remote.php/dav/files/sebastian%20dalton/
WEBDAV_USERNAME=sebastian dalton
WEBDAV_PASSWORD=<copied from standalone .env — Nextcloud app password>
CORPUS_REMOTE_ROOT=Diary              # ← overridden to Diary-spike-test for the spike (compose environment wins)

LLM_BASE_URL=http://lemonade:13305/v1
LLM_CHAT_MODEL=Gemma-4-E4B-it-GGUF
LLM_EMBED_MODEL=nomic-embed-text-v1-GGUF

DB_PATH=data/index.db
DIARY_PORT=8010
DIARY_AUTH_TOKEN=<copied from standalone .env — also goes into litellm/.env>
