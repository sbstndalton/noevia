# Cowork UI env — copy to ui.env and fill in. chmod 600 ui.env on the server.
# Both values are COPIED from the existing stack's secrets — never regenerated.

# Same master key LiteLLM already uses (litellm/.env):
LITELLM_MASTER_KEY=<paste LITELLM_MASTER_KEY here>

# Same diary token the standalone container and sidecar already use. The UI
# proxy also requires it on every /api/* request; the browser unlock screen
# stores it locally and sends it as a bearer token.
# (diary-companion.env — originally copied from the standalone .env):
DIARY_AUTH_TOKEN=<paste DIARY_AUTH_TOKEN here>

# Optional: use a distinct browser-to-proxy token while retaining the diary
# token solely for proxy-to-sidecar calls. Defaults to DIARY_AUTH_TOKEN.
# UI_AUTH_TOKEN=<generate a separate high-entropy token>
