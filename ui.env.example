# Cowork UI env — copy to ui.env and fill in. chmod 600 ui.env on the server.
# Both values are COPIED from the existing stack's secrets — never regenerated.

# Same master key LiteLLM already uses (litellm/.env):
LITELLM_MASTER_KEY=<paste LITELLM_MASTER_KEY here>

# Same diary token the standalone container and sidecar already use
# (diary-companion.env — originally copied from the standalone .env):
DIARY_AUTH_TOKEN=<paste DIARY_AUTH_TOKEN here>
