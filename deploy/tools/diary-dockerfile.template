# Canonical shape of noevia-services' diary/Dockerfile, checked by deploy/tools/assemble-release.sh (dockerfile
# allow-list, "Diary native packaging"). The services Dockerfile must match this file instruction for instruction:
# comments, line continuations and runs of whitespace are normalized away, nothing else is. Changing the Diary
# Dockerfile therefore means changing this template in the same release, which reviewers will see.
#
# [build-stage]    every instruction of the Rust build stage, in order. @NOEVIA_RS_REF@ and @NOEVIA_RS_SHA256@ are the
#                  only placeholders and must equal release/versions.lock.
# [final-from]     the final stage's FROM, exactly. There are exactly two stages.
# [final-runtime]  every USER, WORKDIR, HEALTHCHECK, CMD and ENTRYPOINT of the final stage, exactly and in this order;
#                  the final stage may contain no other and none fewer.
# [install]        the one line that installs the build stage's /out/ bundle; it must occur exactly once.
# [env-fixed]      NAME=value pairs an ENV may set only to exactly this value.
# [final-allowed]  RUN and COPY lines the final stage may contain, exactly ("+ " must be present, "- " may be).
#
# Besides these, the final stage may contain only ENV (never the rs pin, a *_IMPL selector, DIARY_RUST_ROUTES or
# DIARY_RUST_WRITES, PATH, LD_*, PYTHONPATH and the like, or a *_BIN other than [env-fixed]; names are compared after
# Docker-style unquoting), and the free-form LABEL and EXPOSE. ONBUILD, ADD, an extra COPY, rm, ARG, SHELL and
# anything else fail closed. Backslash-newline is removed with nothing inserted, as Docker does, in both this file
# and the Dockerfile.

[build-stage]
FROM rust:1.99-slim-bookworm@sha256:2c3a22f0a5533ea2dd5a16627bc841228151faa2d4de2644ac9987e4a2f1f2fa AS tenant-assertion
ARG NOEVIA_RS_REF=@NOEVIA_RS_REF@
ARG NOEVIA_RS_SHA256=@NOEVIA_RS_SHA256@
ENV RUSTUP_TOOLCHAIN=1.99.0 CARGO_TERM_COLOR=never CARGO_BUILD_JOBS=2
WORKDIR /src
ADD https://codeload.github.com/sbstndalton/noevia-rs/tar.gz/${NOEVIA_RS_REF} /tmp/noevia-rs.tar.gz
RUN echo "${NOEVIA_RS_SHA256}  /tmp/noevia-rs.tar.gz" | sha256sum -c - && tar -xzf /tmp/noevia-rs.tar.gz --strip-components=1 && rm /tmp/noevia-rs.tar.gz && cargo build --release --locked -p tenant-assertion-cli -p workspace-restore-verify-cli -p diary-corpus-write-cli -p diary-corpus-parse -p diary-score-gap -p diary-temporal-focus -p diary-workspace-export -p diary-workspace-import-apply -p diary-entity-focus -p diary-index-transform -p diary-storage-backoff -p diary-workspace-rules -p diary-backup-format -p diary-backup-run -p diary-operator -p noevia-diary && ./target/release/tenant-assertion self-test | grep -qx ok && ./target/release/workspace-restore-verify self-test | grep -qx ok && mkdir /out && cd target/release && cp tenant-assertion workspace-restore-verify diary-corpus-write-cli diary-corpus-parse diary-score-gap diary-temporal-cli diary-workspace-export diary-workspace-import-apply diary-entity-focus diary-index-transform diary-storage-backoff diary-workspace-rules diary-backup-format diary-backup-run diary-backup-restore diary-config noevia-diary /out/ && cd /src && rm -rf /src/target /usr/local/cargo/registry

[final-from]
FROM python:3.12-slim

[final-runtime]
WORKDIR /app
HEALTHCHECK --interval=60s --timeout=10s --retries=3 CMD ["python", "-c", "import os,urllib.request; h={'Authorization':'Bearer '+os.environ.get('DIARY_AUTH_TOKEN','')} if os.environ.get('DIARY_AUTH_TOKEN') else {}; print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8010/api/health', headers=h), timeout=5).status)"]
ENTRYPOINT ["diary-entrypoint"]
CMD ["uvicorn", "agent.app:app", "--host", "0.0.0.0", "--port", "8010"]

[install]
COPY --from=tenant-assertion /out/ /usr/local/bin/

[env-fixed]
DIARY_RUST_SERVER_BIN=/usr/local/bin/noevia-diary
DIARY_WORKSPACE_EXPORT_BIN=/usr/local/bin/diary-workspace-export
TENANT_ASSERTION_BIN=/usr/local/bin/tenant-assertion

[final-allowed]
- COPY requirements.txt constraints.txt ./
- RUN pip install --no-cache-dir --upgrade -c constraints.txt "pip>=26.2" && pip install --no-cache-dir -c constraints.txt -r requirements.txt
+ RUN tenant-assertion self-test | grep -qx ok && workspace-restore-verify self-test | grep -qx ok
+ RUN test -x "$DIARY_RUST_SERVER_BIN" && test -x "$DIARY_WORKSPACE_EXPORT_BIN" && test -x "$TENANT_ASSERTION_BIN"
- COPY agent/ ./agent/
- COPY config/ ./config/
- COPY scripts/ ./scripts/
- RUN python scripts/smoke_workspace_decode.py
+ COPY entrypoint.sh /usr/local/bin/diary-entrypoint
+ RUN chmod 755 /usr/local/bin/diary-entrypoint && diary-backup-restore --help | grep -q '^usage: backup_restore.py ' && diary-config /nonexistent/diary-config-smoke.yaml | grep -qx '{"configured":true}'
+ RUN mkdir /operator-smoke-evidence && DIARY_OPERATOR_SMOKE_ROOT=/operator-smoke-evidence python scripts/smoke_operator_image.py && rm -rf /operator-smoke-evidence
+ RUN python scripts/smoke_diary_leaves.py --all
